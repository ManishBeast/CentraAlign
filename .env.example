# Copy this file to .env and add at least ONE provider key. Never commit .env.

# ---- Models -------------------------------------------------------------
# Ordered fallback list as provider:model pairs. The first usable model is
# tried first; if it hits a rate limit or quota it is benched and the next one
# takes over. Providers: gemini | openai | anthropic | groq
# Entries whose API key is missing below are skipped automatically.
# Model names change often: if you see "404 ... no longer available", remove that entry.
LLM_CHAIN=gemini:gemini-flash-latest,gemini:gemini-flash-lite-latest,groq:openai/gpt-oss-120b,openai:gpt-4.1-mini

# Only used when LLM_CHAIN is empty (single provider mode)
LLM_PROVIDER=gemini
LLM_MODEL=

# ---- API keys (fill in the ones you use) -----------------------------------
# Gemini (free tier): https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Groq (free tier, small limits): https://console.groq.com/keys
GROQ_API_KEY=
# OpenAI (paid): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic (paid): https://console.anthropic.com
ANTHROPIC_API_KEY=

# ---- Behaviour -----------------------------------------------------------------
# true only if your model can read screenshots (uses more tokens)
LLM_VISION=false
# false = you can watch the browser (best for the demo)
HEADLESS=false
# max browser actions per plan step
MAX_BROWSER_STEPS=20
# attempts per plan step before asking a human for a hint
MAX_ATTEMPTS=3
# where the sandbox company runs (python web.py or python app.py)
APP_URL=http://localhost:5050